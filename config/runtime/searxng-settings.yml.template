use_default_settings: true

general:
  instance_name: "Ember CoreUI Search"
  debug: false

search:
  safe_search: 1
  autocomplete: ""
  formats:
    - html
    - json

server:
  secret_key: "{{SEARXNG_SECRET}}"
  bind_address: "127.0.0.1"
  port: {{SEARXNG_PORT}}
  limiter: false
  image_proxy: true

ui:
  static_use_hash: true

