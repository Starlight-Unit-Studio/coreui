worker_processes auto;
pid /tmp/ember-coreui-nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    server_tokens off;
    sendfile on;
    charset utf-8;

    client_body_temp_path /tmp/ember-coreui-client-body;
    proxy_temp_path /tmp/ember-coreui-proxy;
    fastcgi_temp_path /tmp/ember-coreui-fastcgi;
    uwsgi_temp_path /tmp/ember-coreui-uwsgi;
    scgi_temp_path /tmp/ember-coreui-scgi;

    server {
        listen @@BIND_ADDRESS@@:@@HTTP_PORT@@;
        server_name _;

        root /var/www/coreui;
        index index.html;
        client_max_body_size 260m;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

        location ~ ^/(?:config|database|docker|docs|scripts|tools|var|logs|uploads)(?:/|$) {
            return 404;
        }

        location ~ /\. {
            return 404;
        }

        location ~ ^/api/(?:auth|chat|console_stream|console_sessions|console_messages|console_actions|console_browse_stream|console_upload|console_media|storage|memories|user_settings|profile|profile_media|knowledge|account_security|account_export|models|admin|health)\.php$ {
            try_files $uri =404;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param HTTP_PROXY "";
            fastcgi_pass 127.0.0.1:@@PHP_PORT@@;
            fastcgi_read_timeout 900s;
            fastcgi_send_timeout 900s;
            fastcgi_buffering off;
            fastcgi_request_buffering on;
            add_header X-Accel-Buffering "no" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        }

        location ~ \.php$ {
            return 404;
        }

        location ~* ^/(?:css|js|images|assets)/.+\.(?:css|js|png|jpg|jpeg|webp|svg|woff2)$ {
            try_files $uri =404;
            expires 7d;
            add_header Cache-Control "public, max-age=604800";
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        }

        location = / {
            try_files /index.html =404;
        }

        location ~ ^/(?:app|index|login|protocols|settings)\.html$ {
            try_files $uri =404;
        }

        location = /admin/index.html {
            try_files $uri =404;
        }

        location / {
            return 404;
        }
    }
}
